      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"diagnostic_log_segments\" (\"id\" TEXT NOT NULL, \"run_id\" TEXT NULL, \"sequence_start\" INTEGER NOT NULL, \"sequence_end\" INTEGER NOT NULL, \"original_byte_length\" INTEGER NOT NULL, \"compressed_byte_length\" INTEGER NOT NULL, \"compressed_bytes\" BLOB NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
